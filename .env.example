# Copy to .env at the repo root: the web app (apps/web) and the database scripts both read it.
# Everything except DATABASE_URL has a working local default (fake payments and courier, dev logins).

# ─── Database ────────────────────────────────────────────────────────────────
# Local: postgres://fooddel:fooddel@localhost:5432/fooddel
# Supabase (Mumbai): use the transaction pooler URL (port 6543).
DATABASE_URL=postgres://fooddel:fooddel@localhost:5432/fooddel
# Tests create one database per package from this name (fooddel_test_core, …).
TEST_DATABASE_URL=postgres://fooddel:fooddel@localhost:5432/fooddel_test

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Production refuses to start with fake providers or dev logins unless this is 1 (demo deploys).
# ALLOW_DEMO_MODE=1
# Dev-only endpoints (test payments, courier simulator, label stubs). On by default outside production.
# DEV_TOOLS=1
# NEXT_PUBLIC_DEV_TOOLS=1
# Vercel Cron sends this as a Bearer token to /api/v1/jobs/*.
# CRON_SECRET=
# Where at-risk parcel and claim alerts go.
# OPS_PHONE=+919900000002
# OPS_EMAIL=ops@food-del.in

# ─── Sign-in ─────────────────────────────────────────────────────────────────
# dev: phone OTP is shown on screen (code 123456), sessions signed with AUTH_DEV_SECRET.
# supabase: Supabase phone OTP, sessions verified against the project's JWKS.
AUTH_MODE=dev
NEXT_PUBLIC_AUTH_MODE=dev
AUTH_DEV_SECRET=dev-only-secret-change-me-0123456789abcdef
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Payments (Razorpay + Route) ─────────────────────────────────────────────
# PAYMENTS_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── Courier (Shiprocket) ────────────────────────────────────────────────────
# CARRIER_PROVIDER=shiprocket
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_WEBHOOK_TOKEN=
# Our carrier codes → Shiprocket courier company ids, e.g. {"bluedart":1,"delhivery":2}
# SHIPROCKET_COURIER_IDS={}

# ─── Messaging (each channel is optional) ───────────────────────────────────
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_IDS={"ORDER_CONFIRMED":"..."}
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAMES={"ORDER_CONFIRMED":"order_confirmed"}
# RESEND_API_KEY=
# EMAIL_FROM=Food-Del <orders@food-del.in>

# ─── Local scheduler (pnpm --filter @food-del/web jobs:tick) ────────────────
# TICK_SECONDS=30
