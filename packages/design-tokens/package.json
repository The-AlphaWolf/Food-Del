{
  "name": "@food-del/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Brand tokens as TypeScript (for React Native) and generated Tailwind v4 @theme CSS (for web).",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css"
