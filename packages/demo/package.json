{
  "name": "@food-del/demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The whole backend (API, core, Postgres via PGlite) running in the browser, for the static GitHub Pages demo.",
  "exports": {
    ".": "./src/backend.ts"
  },
  "scripts": {
    "gen": "node scripts/gen-migrations.mjs",
    "typecheck": "node scripts/gen-migrations.mjs && tsc -p tsconfig.json",
    "test": "node scripts/gen-migrations.mjs && vitest run",
    "bundle": "node scripts/gen-migrations.mjs && node scripts/bundle.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@food-del/api": "workspace:*",
    "@food-del/core": "workspace:*",
    "@food-del/db": "workspace:*",
    "@food-del/domain": "workspace:*",
    "@food-del/integrations": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@food-del/config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
